{
  "name": "gestor-api",
  "productName": "Gestor API",
  "version": "0.1.0",
  "description": "Catálogo visual de APIs: endpoints documentados, autenticación guardada y llamadas sin complicaciones",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Jesús Liz Alles",
  "license": "MIT",
  "homepage": "https://github.com/JesusLizAlles/gestor-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesusLizAlles/gestor-api.git"
  },
  "bugs": {
    "url": "https://github.com/JesusLizAlles/gestor-api/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac dmg --arm64 --x64",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "icons": "bash scripts/build-icons.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
